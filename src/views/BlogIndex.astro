---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { entrySlug, formatMonth, inLang, localize, readingTime, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const posts = inLang(await getCollection('blog'), lang).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base lang={lang} title={t('blog.title')} description={t('blog.description')}>
  <section class="mx-auto max-w-6xl px-4 pt-14 sm:px-6 sm:pt-20">
    <p class="label">{posts.length} {t('blog.count')}</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">{t('blog.title')}</h1>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-muted">{t('blog.intro')}</p>

    <ul class="mt-12 border-t border-line">
      {
        posts.map((post) => (
          <li class="border-b border-line" data-reveal>
            <a
              href={localize(lang, `/blog/${entrySlug(post.id)}`)}
              class="group grid gap-2 py-7 sm:grid-cols-[150px_1fr] sm:gap-6"
            >
              <span class="label pt-1.5">{formatMonth(post.data.date, lang)}</span>
              <span>
                <span
                  class="block text-xl font-medium tracking-tight transition-colors group-hover:text-accent sm:text-2xl"
                  style={`view-transition-name: post-${entrySlug(post.id)}`}
                >
                  {post.data.title}
                </span>
                <span class="mt-2 block max-w-[62ch] leading-relaxed text-muted">{post.data.excerpt}</span>
                <span class="label mt-3 flex flex-wrap gap-x-3">
                  <span>
                    {readingTime(post.body)} {t('blog.read')}
                  </span>
                  {post.data.tags.map((tag) => (
                    <span>#{tag.toLowerCase()}</span>
                  ))}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
