---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CertBadges from '../components/CertBadges.astro';
import CloudsBackground from '../components/clouds/CloudsBackground';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Lab from '../components/lab/Lab';
import ProjectRow from '../components/ProjectRow.astro';
import SectionHead from '../components/SectionHead.astro';
import { entrySlug, formatMonth, inLang, localize, readingTime, useTranslations, type Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const projects = inLang(await getCollection('projects'), lang).sort((a, b) => a.data.order - b.data.order);
const posts = inLang(await getCollection('blog'), lang).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
// Pitch with one phrase set in the title face
const [pitchBefore, pitchAfter] = site.pitch[lang].split(site.pitchEmphasis[lang]);
const button =
  'inline-flex items-center gap-2 rounded-md border border-line bg-bg/70 px-3.5 py-2 text-sm backdrop-blur-sm transition-colors hover:border-faint';
---

<Base lang={lang}>
  <section class="relative isolate">
    <CloudsBackground client:only="react" />
    <div class="mx-auto max-w-6xl px-4 pt-14 pb-14 sm:px-6 sm:pt-24 sm:pb-20">
      <p class="label"><span class="text-accent">~</span> $ whoami</p>
      <h1 class="mt-4 text-5xl leading-[0.95] font-bold tracking-tight sm:text-7xl lg:text-8xl">
        {site.name}
      </h1>
      <p class="mt-5 font-mono text-sm text-muted sm:text-base">{site.role}</p>
      <p class="mt-8 max-w-[34ch] text-2xl leading-snug text-muted sm:text-3xl sm:leading-snug">
        {pitchBefore}<strong class="font-display font-semibold text-fg">{site.pitchEmphasis[lang]}</strong>{pitchAfter}
      </p>

      <div class="mt-10 flex flex-wrap gap-2 font-mono">
        <a
          href={site.cv}
          download
          class="inline-flex items-center gap-2 rounded-md bg-fg px-3.5 py-2 text-sm font-medium text-bg transition-opacity hover:opacity-85"
        >
          CV <span aria-hidden="true">↓</span>
        </a>
        <a href={site.linkedin} target="_blank" rel="noopener" class={button}>
          LinkedIn <span aria-hidden="true">↗</span>
        </a>
        <a href={site.github} target="_blank" rel="noopener" class={button}>
          GitHub <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-12 border-t border-line pt-10 lg:grid-cols-[1.15fr_1fr] lg:gap-20">
      <div>
        <p class="label mb-5">{t('home.experience')}</p>
        <Experience lang={lang} />
        <p class="label mt-10 mb-3">{t('home.education')}</p>
        <Education lang={lang} />
      </div>
      <div>
        <p class="label mb-2">{t('home.certifications')}</p>
        <CertBadges lang={lang} />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-28 sm:px-6">
    <SectionHead title={t('home.projects')} href={localize(lang, '/projects')} link={t('home.allProjects')} />
    <div class="mt-2 [&>article:first-child]:border-t-0">
      {projects.map((project) => <ProjectRow project={project} lang={lang} />)}
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead title={t('home.writing')} href={localize(lang, '/blog')} link={t('home.allPosts')} />
    <ul class="divide-y divide-line">
      {
        posts.map((post) => (
          <li data-reveal>
            <a
              href={localize(lang, `/blog/${entrySlug(post.id)}`)}
              class="group flex flex-col gap-1 py-5 sm:grid sm:grid-cols-[150px_1fr_auto] sm:items-baseline sm:gap-6"
            >
              <span class="label">{formatMonth(post.data.date, lang)}</span>
              <span
                class="font-display text-lg font-semibold tracking-tight transition-colors group-hover:text-accent sm:text-xl"
                style={`view-transition-name: post-${entrySlug(post.id)}`}
              >
                {post.data.title}
              </span>
              <span class="label">{readingTime(post.body)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <SectionHead title={t('home.lab')} />
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-muted">{t('home.labIntro')}</p>
    <div class="mt-8">
      <Lab client:visible lang={lang} />
    </div>
  </section>
</Base>
