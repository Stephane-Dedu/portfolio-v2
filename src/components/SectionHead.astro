---
interface Props {
  title: string;
  href?: string;
  link?: string;
}
const { title, href, link } = Astro.props;
---

<div class="flex items-end justify-between gap-4 border-b border-line pb-4">
  <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h2>
  {
    href && (
      <a href={href} class="label group inline-flex items-center gap-1 hover:text-fg">
        {link}
        <span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
      </a>
    )
  }
</div>
