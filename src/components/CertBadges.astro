---
import CertIcon from './CertIcon.astro';
import type { Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const verifyLabel = lang === 'fr' ? 'vérifier sur Credly' : 'verify on Credly';
---

<ul class="space-y-1 font-rounded" aria-label="Certifications">
  {
    site.certs.map((cert) => (
      <li>
        <a
          href={cert.verify}
          target="_blank"
          rel="noopener"
          aria-label={`${cert.name}, ${cert.issuer}, ${cert.issued[lang]} (${verifyLabel})`}
          class="group flex items-center gap-3.5 py-2"
        >
          <span class="grid size-9 shrink-0 place-items-center">
            <CertIcon
              name={cert.icon}
              class="size-6 opacity-85 transition-[opacity,transform] duration-300 group-hover:scale-110 group-hover:opacity-100"
            />
          </span>
          <span class="min-w-0">
            <span class="block text-base leading-snug font-medium text-fg/90 underline decoration-transparent underline-offset-4 transition-colors group-hover:decoration-faint">{cert.name}</span>
            <span class="mt-1 block text-sm text-muted">{cert.issuer} · <span class="whitespace-nowrap">{cert.issued[lang]}</span></span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
