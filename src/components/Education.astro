---
import type { Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<ul class="font-rounded" aria-label={lang === 'fr' ? 'Formation' : 'Education'}>
  {
    site.education.map((item) => (
      <li>
        <p class="text-lg leading-snug font-bold">{item.degree[lang]}</p>
        <p class="mt-0.5 text-base font-medium text-muted">{item.school}</p>
        <p class="mt-0.5 text-sm text-muted">{item.period}</p>
      </li>
    ))
  }
</ul>
