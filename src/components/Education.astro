---
import type { Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<ul class="font-rounded" aria-label={lang === 'fr' ? 'Formation' : 'Education'}>
  {
    site.education.map((item) => (
      <li>
        <p class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-0.5">
          <span class="text-[15px] leading-snug font-bold">{item.degree[lang]}</span>
          <span class="text-[13px] text-muted">{item.period}</span>
        </p>
        <p class="text-[14px] font-medium text-muted">{item.school}</p>
      </li>
    ))
  }
</ul>
