---
import type { Lang } from '../i18n/ui';
import { site } from '../lib/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="font-rounded">
  <ul class="grid gap-8 sm:grid-cols-2 sm:gap-10" aria-label={lang === 'fr' ? 'Expérience' : 'Experience'}>
    {
      site.experience.map((item) => (
        <li>
          <p class="text-lg leading-snug font-bold">{item.role[lang]}</p>
          <p class="mt-0.5 text-base font-medium text-muted">{item.company}</p>
          <p class="mt-0.5 text-sm text-muted">{item.period[lang]}</p>
          {item.details && <p class="mt-2 max-w-[62ch] text-[15px] leading-relaxed text-muted">{item.details[lang]}</p>}
        </li>
      ))
    }
  </ul>
</div>
